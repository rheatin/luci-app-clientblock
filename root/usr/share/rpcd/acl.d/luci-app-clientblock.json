{
	"luci-app-clientblock": {
		"description": "Grant access to LAN client block management",
		"read": {
			"ubus": {
				"luci.clientblock": [ "list", "status", "iplist", "autoget", "loglist", "selfcheck", "schedlist" ]
			}
		},
		"write": {
			"ubus": {
				"luci.clientblock": [ "block", "unblock", "unblock_all", "rename", "ipadd", "ipdel", "ipflush", "sync", "scan", "autoset", "logevent", "logclear", "schedadd", "scheddel", "schedtoggle", "schedeval" ]
			},
			"file": {
				"/etc/nftables.d/*": [ "write" ],
				"/etc/clientblock/*": [ "write" ],
				"/bin/fw4": [ "exec" ]
			}
		}
	}
}
